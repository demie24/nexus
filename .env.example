# ==============================================================================
# NEXUS — AI-Orchestrated Decision Intelligence & Digital Twin Platform
# Configuration Template (.env.example)
# NOTE: Copy this file to .env and adjust values for your local environment.
# Never commit .env with real secrets to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# API Gateway & Backend
API_HOST=0.0.0.0
API_PORT=8080
API_SECRET_KEY=change_this_to_a_secure_random_32_byte_secret_key
API_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL)
POSTGRES_USER=nexus_user
POSTGRES_PASSWORD=nexus_secure_password
POSTGRES_DB=nexus_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
DATABASE_URL=postgresql://nexus_user:nexus_secure_password@localhost:5434/nexus_db

# Cache & Event Broker (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Industrial Telemetry Broker (Mosquitto MQTT)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1884
MQTT_TOPIC_TELEMETRY=nexus/telemetry/+
MQTT_TOPIC_COMMANDS=nexus/commands/+

# Synthetic Simulator
SIMULATOR_ENABLED=True
SIMULATOR_TICK_SECONDS=1.0
SIMULATOR_NOISE_STD=0.02
SIMULATOR_AUTO_DEGRADE=False

# Machine Learning & Anomaly Engine
ANOMALY_SENSITIVITY=0.85
PREDICTION_HORIZON_STEPS=120
RUL_BASE_HOURS=2400.0

# Frontend Configuration
FRONTEND_PORT=5180
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_BASE_URL=ws://localhost:8080/api/v1/ws

# Optional Natural Language LLM Layer (Optional - System works 100% deterministically without these)
LLM_PROVIDER=none
LLM_API_KEY=
